# Copy to .env.production. Use a real DNS name and independently generated hex secrets.
SITE_DOMAIN=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
OTP_HASH_SECRET=
EMAIL_FROM=
# Setup: docs/DELIVERY-AND-VERIFICATION.md. Check without sending: npm run providers:check -- --smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
COMPANY_VERIFICATION_URL=
COMPANY_VERIFICATION_API_KEY=
# Direct Indian CIN verification: choose cashfree and configure live Secure ID access.
# Sandbox never verifies a real company. See docs/SMS-COMPANY-PROVIDERS.md.
COMPANY_VERIFICATION_PROVIDER=http
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional RSA public PEM with escaped \n; otherwise allowlist the API server IP.
CASHFREE_PUBLIC_KEY=
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=
SMS_DELIVERY_URL=
SMS_DELIVERY_API_KEY=
# Twilio supports SMS and public TURN using the same account credentials.
# Production requires an API key; keep its secret server-side.
SMS_PROVIDER=http
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=
TURN_URL=
TURN_SECRET=
# Set twilio for managed TURN, or hmac for a secured public Coturn host.
TURN_PROVIDER=hmac
TURN_LOCAL_DEV=false
TURN_TTL_SECONDS=3600
# Flag repeated interview-tab departures for human review after this many occurrences (1–20).
# Events are recorded from the first departure; this threshold never rejects a candidate.
TAB_SWITCH_WARNING_THRESHOLD=3
