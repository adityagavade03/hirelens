# Copy to .env.production. Keep it private (chmod 600 on Linux).
# Use a real DNS name and four DIFFERENT 64-character hex secrets (openssl rand -hex 32).
# Literal dollar signs in provider secrets must be inside single quotes; Compose expands unquoted/double-quoted $ values.
# Guide and no-send validation: docs/PRODUCTION-DEPLOYMENT.md.
# For native Render/Atlas, use docs/RENDER-DEPLOYMENT.md instead of the Compose-only secrets below.
# Set MONGODB_URI privately in Render; never use a laptop localhost address.
# Optional existing-company cloud test: uncomment both only with explicit approval.
# CLOUD_TEST_COMPANY_IDS=<one-or-two-approved-company-ids>
# CLOUD_TEST_EXPIRES_AT=<original-absolute-UTC-expiry-within-31-days>
# Omit every PRIVATE_PREVIEW_* setting when using that cloud test policy.
SITE_DOMAIN=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
OTP_HASH_SECRET=
# Optional shared upload guard. Blank preserves existing storage behavior.
# Atlas Free: use 400 with atlas-cluster to leave room below its 0.5 GB limit.
STORAGE_BUDGET_MB=
STORAGE_BUDGET_SCOPE=database
EMAIL_FROM=
# auto preserves SMTP-first selection; choose brevo for direct HTTPS delivery.
EMAIL_PROVIDER=auto
BREVO_API_KEY=
# Setup: docs/DELIVERY-AND-VERIFICATION.md. Check without sending: npm run providers:check -- --smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
COMPANY_VERIFICATION_URL=
COMPANY_VERIFICATION_API_KEY=
# Direct Indian CIN verification: choose cashfree and configure live Secure ID access.
# Sandbox never verifies a real company. See docs/SMS-COMPANY-PROVIDERS.md.
COMPANY_VERIFICATION_PROVIDER=http
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional RSA public PEM with escaped \n; otherwise allowlist the API server IP.
CASHFREE_PUBLIC_KEY=
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=
SMS_DELIVERY_URL=
SMS_DELIVERY_API_KEY=
# Twilio supports SMS and public TURN using the same account credentials.
# Production requires an API key; keep its secret server-side.
SMS_PROVIDER=http
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
# Optional separately consented speaker clustering. Must be reachable from the app container.
# A URL on this laptop's localhost is not reachable from a Linux server/container.
DIARIZATION_URL=
DIARIZATION_API_KEY=
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=
TURN_URL=
TURN_SECRET=
# Set twilio for managed TURN, or hmac for a secured public Coturn host.
TURN_PROVIDER=hmac
TURN_LOCAL_DEV=false
TURN_TTL_SECONDS=3600
# Bundled local camera models. Optional stronger object preview remains experimental.
OBJECT_MODEL_URL=/vendor/mediapipe/efficientdet_lite0.tflite
OBJECT_ACCURACY_MODEL_URL=/vendor/mediapipe/efficientdet_lite2.tflite
# Flag repeated interview-tab departures for human review after this many occurrences (1–20).
# Events are recorded from the first departure; this threshold never rejects a candidate.
TAB_SWITCH_WARNING_THRESHOLD=3
