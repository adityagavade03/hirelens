# Coturn 4.18.0 public IPv4 host template; not an active or ready-to-run service.
# Replace every REPLACE_ value and turn.example.com before starting it.
# See docs/TURN-SETUP.md. Keep TURN_LOCAL_DEV=false in HireLens.
# Bind only the selected host interface, not every interface on the machine.
listening-ip=REPLACE_WITH_SERVER_INTERFACE_IPV4
relay-ip=REPLACE_WITH_SERVER_INTERFACE_IPV4
listening-port=3478
tls-listening-port=5349

# The secret must match HireLens TURN_SECRET. Never use no-auth or static users.
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
realm=turn.example.com
server-name=turn.example.com
stale-nonce=600
unauthorized-ratelimit
unauthorized-ratelimit-rps=10

# For a host behind 1:1 NAT: PUBLIC_IP/INTERFACE_IP, with identical port mapping.
# When the public IP is assigned directly to the interface, omit external-ip.
external-ip=REPLACE_WITH_PUBLIC_IPV4/REPLACE_WITH_SERVER_INTERFACE_IPV4
min-port=49160
max-port=49200

# Small pilot limits, not a capacity guarantee. Bandwidth values are bytes/sec.
user-quota=4
total-quota=20
max-bps=2000000
bps-capacity=20000000

# UDP relays still support clients connecting over TCP/TLS (WebRTC fallback).
no-tcp-relay
# HireLens uses its separately configured STUN service; this host serves TURN.
no-stun
cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem

# Prevent the relay reaching private infrastructure or link-local metadata.
# Coturn uses IP-IP ranges, not CIDR. An allowed-peer-ip overrides a denial:
# do not copy the local WSL helper's allowed-peer-ip into public deployments.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::-::1
denied-peer-ip=::ffff:0:0-::ffff:ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# Add any other deployment-specific internal/metadata destinations as denials.
# Loopback is also denied by default. Never enable allow-loopback-peers.
no-multicast-peers
# Coturn 4.18.0 leaves CLI, web-admin and DTLS disabled by default.
# Run under a dedicated service account with narrowly scoped certificate access.
log-file=stdout
log-min-level=info
