{
  "name": "hirelens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "db:local": "tsx scripts/local-db.ts",
    "seed": "tsx server/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "setup:assets": "tsx scripts/setup-assets.ts",
    "doctor": "tsx scripts/doctor.ts",
    "providers:check": "tsx scripts/check-providers.ts",
    "providers:setup": "powershell -NoProfile -File scripts/setup-providers.ps1",
    "deploy:check": "tsx scripts/production-preflight.ts",
    "speech:setup": ".data/speech/venv/Scripts/python.exe -I scripts/setup-speech-model.py",
    "speech:evaluate": ".data/speech/venv/Scripts/python.exe -I scripts/evaluate-speech.py",
    "email:setup:gmail": "powershell -NoProfile -File scripts/setup-gmail.ps1",
    "media:check": "tsx scripts/check-media.ts",
    "code:prepare": "tsx scripts/local-code.ts --prepare",
    "code:local": "tsx scripts/local-code.ts",
    "code:check": "tsx scripts/check-code.ts",
    "turn:local": "tsx scripts/local-turn.ts",
    "diarization:check": "tsx scripts/check-diarization.ts",
    "integrity:research": "tsx scripts/train-integrity.ts",
    "ai:check": "tsx scripts/check-local-ai.ts",
    "ai:quality": "tsx scripts/check-ai-quality.ts",
    "resume:check": "tsx scripts/check-resume-ai.ts",
    "local:start": "powershell -NoProfile -File scripts/start-local.ps1",
    "preview:private": "tsx scripts/start-private-preview.ts",
    "preview:stop": "tsx scripts/stop-private-preview.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "@monaco-editor/react": "^4.7.0",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "@tailwindcss/vite": "^4.1.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "mongoose": "^9.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.13",
    "pdf-parse": "^2.4.0",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.17.2",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "redis": "^6.3.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "tailwindcss": "^4.1.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "^30.1.2",
    "mongodb-memory-server": "^10.4.0",
    "prettier": "^3.9.9",
    "supertest": "^7.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}
