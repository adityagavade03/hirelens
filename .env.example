PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/hirelens
NODE_ENV=development
SESSION_HOURS=24
# Choose http (custom adapter) or cashfree (Indian CIN). Setup: docs/SMS-COMPANY-PROVIDERS.md.
COMPANY_VERIFICATION_PROVIDER=http
COMPANY_VERIFICATION_URL=
COMPANY_VERIFICATION_API_KEY=
# Cashfree live CIN access is required for real verification. Sandbox never marks a company verified.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional downloaded RSA public key; otherwise whitelist server IPv4 in Cashfree.
# Use a quoted multiline PEM value, or literal \n between PEM lines. Never a private key.
CASHFREE_PUBLIC_KEY=
# Explicit localhost-only development signup. Companies remain unverified.
# Enables local job publishing; sign-in OTP is still required. Never enabled in production.
ALLOW_LOCAL_COMPANY_REGISTRATION=false
# Email delivery adapter; accepts {from,to,subject,text}, returns {accepted:true,messageId}.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=
EMAIL_FROM=
# Generate a random secret with at least 32 characters; keep it server-side.
OTP_HASH_SECRET=
COMPANY_LOGIN_OTP_REQUIRED=true
# Optional development demo; keep false for an empty workspace and real accounts.
# Setting true explicitly also permits the optional seed command. Never enabled in production.
ALLOW_DEMO_LOGIN=false
# OpenAI-compatible chat/completions provider; no keys go in VITE_ variables.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# OpenAI-compatible audio/transcriptions endpoint.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
# Optional, separately consented speaker clustering for saved candidate clips.
# Setup and limitations: docs/ADVANCED-PROCTORING.md. This is not speaker identity or a cheating score.
DIARIZATION_URL=
DIARIZATION_API_KEY=
# The Python service uses its own process environment for optional model overrides:
# DIARIZATION_SEGMENTATION_MODEL=.data/diarization/models/sherpa-onnx-pyannote-segmentation-3-0/model.int8.onnx
# DIARIZATION_EMBEDDING_MODEL=.data/diarization/models/nemo_en_titanet_small.onnx
# DIARIZATION_CLUSTER_THRESHOLD=0.5
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=
STUN_URL=stun:stun.l.google.com:19302
# hmac uses TURN_URL/TURN_SECRET; twilio uses the shared Twilio credentials below.
TURN_PROVIDER=hmac
# Comma-separated UDP/TCP/TLS relay URLs, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URL=
TURN_SECRET=
TURN_TTL_SECONDS=3600
# Set by npm run turn:local only for the same-computer WSL test relay; forbidden in production.
# Public/cross-network meetings require an actual public relay and TURN_LOCAL_DEV=false.
TURN_LOCAL_DEV=false
FACE_EVENT_SECONDS=5
TAB_SWITCH_WARNING_THRESHOLD=3
# Absolute HTTPS URL or same-origin path for the MediaPipe BlazeFace short-range model.
FACE_MODEL_URL=/vendor/mediapipe/blaze_face_short_range.tflite
MEDIAPIPE_WASM_URL=/vendor/mediapipe/wasm
# Local Face Landmarker for the experimental opt-in gaze preview; run npm run setup:assets.
# No gaze coordinates or model are uploaded or used in hiring/integrity scores.
FACE_LANDMARK_MODEL_URL=/vendor/mediapipe/face_landmarker.task
# Optional local object preview; install with npm run setup:assets. Separate camera consent is required.
# Only sustained phone/book metadata after room admission is shared for human review; no frames or automatic cheating score.
# Experimental accuracy and supported-label limits: docs/OBJECT-DETECTION.md.
OBJECT_MODEL_URL=/vendor/mediapipe/efficientdet_lite0.tflite
OBJECT_EVENT_SECONDS=3
DEMO_PASSWORD=HireLensDemo!2026

# Local development messages are saved to .data/messages, never sent externally.
MESSAGE_PREVIEW=true
EMAIL_VERIFICATION_REQUIRED=false
# SMTP is an alternative to the HTTP email adapter. Setup: docs/DELIVERY-AND-VERIFICATION.md
# Run npm run providers:check -- --smtp to test connectivity/auth without sending.
# Port 587 uses SMTP_SECURE=false (STARTTLS); port 465 requires SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Choose http (custom adapter) or twilio (native SMS). No account is created automatically.
SMS_PROVIDER=http
# HTTP adapter: {to,text} -> {accepted:true,messageId}.
SMS_DELIVERY_URL=
SMS_DELIVERY_API_KEY=
# Shared with TURN_PROVIDER=twilio. Prefer a scoped API key; required in production.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Optional Auth Token fallback only outside production, when no API key is entered.
TWILIO_AUTH_TOKEN=
# SMS needs an authorized E.164 From/registered sender OR a Messaging Service SID.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
RESUME_OCR_ENABLED=true
OCR_LANGUAGE_PATH=.data/ocr
# Optional shared rate limiting and Socket.IO signaling; authenticated private Redis.
REDIS_URL=
